{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacks": {
      "lang": "python"
    }
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "OnFailure",
    "restartPolicyMaxRetries": 10,
    "runtime": "uvicorn main:app --host 0.0.0.0 --port $PORT",
    "healthCheckPath": "/docs"
  }
}